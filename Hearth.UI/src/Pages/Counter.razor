@page "/counter"
@using Hearth.Services.Interfaces.Finance
@using Hearth.Services.Interfaces
@using Hearth.Services.DTOs.Finance.Account
@using Hearth.Services.DTOs.Finance.Transaction
@using Hearth.Services.DTOs.Finance.TransactionCategory
@using Hearth.Services.DTOs
@inject IAccountService _accountService
@inject ITransactionService _transactionService
@inject ITransactionCategoryRuleService _transactionCategoryRuleService
@inject IRuleConditionService _ruleService

<h1>Stuff</h1>

<div>
    @if (accounts is null)
    {
        <p>Loading...</p>
    }
    else if (accounts.Count == 0)
    {
        <p>No accounts found.</p>
    }
    else
    {
        <ul>
            @foreach (var account in accounts)
            {
                <li>
                    @account.Name — @account.Balance_Current?.ToString("C")
                    @if (account.Is_Credit_C)
                    {
                        <span> (Credit)</span>
                    }
                </li>
            }
        </ul>
    }

    @if (transactionCategoryRules is null)
    {
        <p>Loading...</p>
    }
    else if (transactionCategoryRules.Count == 0)
    {
        <p>No transactionCategoryRules found.</p>
    }
    else
    {
        <ul>
            @foreach (var t in transactionCategoryRules)
            {
                <li>
                    Name: @t?.Name -- @t.TransactionCategoryId
                </li>
            }
        </ul>
    }


    @if (transactions is null)
    {
        <p>Loading...</p>
    }
    else if (transactions.Count == 0)
    {
        <p>No transactions found.</p>
    }
    else
    {
        <ul>
            @foreach (var t in transactions)
            {
                <li>
                    @t?.Name — @t?.Amount.ToString("C") -- @t.CategoryId
                </li>
            }
        </ul>
    }

    <div>
        <Button OnClick="EvaluateTransactions" Variant="E_VARIANT.Primary">Evaluated Transactions</Button>
        <button @onclick="CreateRule">Create Transaction Category Rule</button>
        <button @onclick="CreateCondition">Create Condition</button>
    </div>

</div>

@code {
    private List<AccountDTO>? accounts;
    private List<TransactionDTO>? transactions;

    private List<TransactionCategoryRuleDTO>? transactionCategoryRules;

    protected override async Task OnInitializedAsync()
    {
        accounts = await _accountService.GetAll();
        transactions = await _transactionService.GetAll();
        transactionCategoryRules = await _transactionCategoryRuleService.GetAll();
    }

    private void EvaluateTransactions()
    {
        _transactionCategoryRuleService.RunRuleSet(transactionCategoryRules[0].Id, transactions);
    }

    private async void CreateRule()
    {
        var dto = new TransactionCategoryRuleDTO
        {
            Name = "Turn to Target",
            Active = true,
            Priority = 1,
            TransactionCategoryId = 1
        };

        var created = await _transactionCategoryRuleService.Create(dto);
    }

    private async void CreateCondition()
    {
        var dto = new RuleConditionDTO
        {
            Condition = "starts_with",
            Field = "Merchant_Name",
            Match = "Targ",
            RuleId = 2,
        };

        var created = await _ruleService.Create(dto);
    }
}
