@page "/finance/reports"
@using Hearth.Services.DTOs.Finance.Report
@using Hearth.Services.CTOs.Finance.Report
@inject IUserService _userService
@inject IReportService _reportService
@inject IJSRuntime JS
@inject NavigationManager _nav

@* Loading *@

@if (initialRenderComplete == false)
{
    <LoadingCircleIcon AutoCenter="true" />
}

@* Page *@

<main class="main-reports" hidden="@(initialRenderComplete ? false : true)">
    <section class="section-page-title">
        <Title>
            Reports
        </Title>
    </section>
    @if (Reports?.Count >= 1 && Reports != null)
    {
        @* - Actual Page Content - *@
        <section class="section-01">
            <article class="s01-article-01">
                @foreach (var report in Reports)
                {
                    <div class="s01-a01-card-container" @onclick="() => HandleSelectReport(report.Id)">
                        <Card HoverEffects="true">
                            <CardContent>
                                <div class="report-card-content">
                                    <div class="report-card-header">
                                        <div class="name">
                                            @report.Name
                                        </div>
                                        <div class="description">
                                            @report.Description
                                        </div>
                                    </div>
                                    <div class="report-card-body" @onclick:stopPropagation>
                                        <div class="delete-btn">
                                            <ButtonIconOnly Color="E_COLOR_BASIC.Secondary" OnClick="@(() => OpenRemoveReportModal(report.Id))">
                                                <TrashIcon Size="32" />
                                            </ButtonIconOnly>
                                        </div>
                                        <div class="edit-btn">
                                            <ButtonIconOnly OnClick="@(() => HandleEditReport(report.Id))">
                                                <EditIcon Size="32" />
                                            </ButtonIconOnly>
                                        </div>
                                    </div>
                                </div>
                            </CardContent>
                        </Card>
                    </div>
                }
            </article>
        </section>
    }
    else
    {
        <section class="section-no-records">
            <div class="title-container">
                <Title>No Reports Found...</Title>
            </div>
        </section>
    }
</main>

@* Toolbar *@

<Toolbar HasAddBtn="true"
         OnAdd="HandleAddReport"
         HasSearchBtn="false"
         HasManageBtn="false"
         HasSettingsBtn="true"
         Position="E_TOOLBAR_POSITION.BottomRight"
         Size="E_SIZE.lg"
         TooltipSubject="Report" />

@* Modal *@

<Modal
    Title="Create a new Report?"
    Open="showConfirmAddReportModal"
    OnClose="CloseConfirmAddReportModal"
>
    <div>
        <div>
            <p>Create a new <strong>Report</strong> and enter the <strong>Report Builder</strong>?</p>
        </div>
        <div class="create-report-modal-footer">
            <Button Variant="E_VARIANT.Outline">Cancel</Button>
            <Button Color="E_COLOR_BASIC.Info" OnClick="HandleConfirmAddReport">Create</Button>
        </div>
    </div>
</Modal>

@* Delete Report Modal *@

<DeleteConfirmationModal Open="showRemoveReportModal"
                         OnClose="CloseRemoveReportModal"
                         OnRemove="HandleRemoveReport"
                         ObjectName="Report"
                         ItemName="@(selectedReport?.Name)"
                         FromName="Hearth" />

@code {
    // - Loading -
    bool initialRenderComplete = false;
    bool resizeInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (initialRenderComplete == false && Reports != null)
            {
                initialRenderComplete = true;
                StateHasChanged(); // Trigger re-render to hide the spinner
            }

        }
    }


    // - Page -
    UserDTO? currentUser = null;

    List<ReportDTO>? Reports = new();
    ReportCTO cto = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await _userService.GetCurrentUser();
            Reports = await _reportService.GetAll();
        }
        catch (HearthRecordNotFoundException ex)
        {
            // TODO show error toast
        }
    }

    // - CTO -



    // - Filter -

    // - Select Report -
    void HandleSelectReport(int reportId)
    {
        _nav.NavigateTo($"/finance/reports/{reportId}");
    }

    // - Add Report -
    bool showConfirmAddReportModal = false;
    void OpenConfirmAddReportModal() => showConfirmAddReportModal = true;
    void CloseConfirmAddReportModal() => showConfirmAddReportModal = false;

    void HandleAddReport()
    {
        OpenConfirmAddReportModal();
    }

    async void HandleConfirmAddReport()
    {
        int draftReportId = await _reportService.CreateBuilderDraft();
        _nav.NavigateTo($"/finance/reports/builder/{draftReportId}");
    }

    // - Edit Report -

    void HandleEditReport(int reportId)
    {
        _nav.NavigateTo($"/finance/reports/builder/{reportId}");
    }

    // - Delete Report -
    bool showRemoveReportModal = false;
    async void OpenRemoveReportModal(int reportId)
    {
        showRemoveReportModal = true;
        selectedReport = await _reportService.GetById(reportId);
    }
    void CloseRemoveReportModal()
    {
        showRemoveReportModal = false;
    }
    ReportDTO? selectedReport = null;

    async void HandleRemoveReport()
    {
        // Need to do a special delete that also deletes rules and conditions assosiated
        await _reportService.DeleteWithAll(selectedReport.Id);
        CloseRemoveReportModal();
        // TODO in the future, i could probably replace all these re-fetches with just simple Reports.RemoveAt(index). But for now this is fine.
        Reports = await _reportService.GetAll();
    }
}