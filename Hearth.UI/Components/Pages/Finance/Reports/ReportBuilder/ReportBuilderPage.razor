@page "/finance/reports/builder/{ReportId:int}"
@using Hearth.Services.DTOs
@using Hearth.Services.DTOs.Finance.Report
@using Hearth.UI.Components.Elements.Finance.Rules.RuleConditions
@inject IUserService _userService
@inject IReportService _reportService
@inject IReportTransactionRuleService _reportTranRuleService

@if (draftReport is null)
{
    <LoadingCircleIcon AutoCenter="true" />
}
else
{
    <main class="main-report-builder">
        <section class="section-page-title">
            <Title>Report Builder</Title>
        </section>

        <section class="section-01">
            <article class="s01-article-01">
                <div class="s01-a01-form-container">
                    <Form>
                        <FormHeader>
                            <FormTitle>@draftReport.Name</FormTitle>
                            <FormDescription>@draftReport.Description</FormDescription>
                        </FormHeader>
                        <FormContent>
                            <FormRow>
                                <FormCell Ratio="2/5">
                                    <Input Label="Report Name" @bind-Value="draftReport.Name" />
                                </FormCell>
                                <FormCell Ratio="3/5">
                                    <Input Label="Description" @bind-Value="draftReport.Description" />
                                </FormCell>
                            </FormRow>

                            @foreach (var rule in draftReport.TransactionRules)
                            {
                                <FormRow @key="rule.Id">
                                    <FormCell Ratio="1">
                                        <RuleConditionsTableElement Rule="rule"
                                                                    OnRemoveRule="HandleRemoveRule" />
                                    </FormCell>
                                </FormRow>
                            }
                        </FormContent>
                    </Form>
                </div>
            </article>
        </section>
    </main>
}

@* Toolbar *@
<Toolbar HasAddBtn="true"
         OnAdd="OpenAddRuleModal"
         HasSaveBtn="true"
         OnSave="HandleSaveReport"
         Position="E_TOOLBAR_POSITION.BottomRight"
         Size="E_SIZE.lg"
         TooltipSubject="Report Rule" />

@* Add Rule Modal *@
<Modal Title="Add Rule to Report"
       Open="showAddRuleModal"
       OnClose="CloseAddRuleModal"
       Variant="E_MODAL.Unset">
    <Form>
        <FormContent>
            <FormRow>
                <FormCell Ratio="2/7">
                    <Input Label="Name" @bind-Value="draftTransactionRule.Name" />
                </FormCell>
                <FormCell Ratio="2/7">
                    <Input Label="Priority" InputType="E_INPUT_TYPE.Number" @bind-Value="draftTransactionRule.Priority" />
                </FormCell>
                <FormCell Ratio="3/7" AlignRight="true" CenterVertically="true">
                    <Checkbox Label="Active" @bind-Value="draftTransactionRule.Active" FlipLabel="true" />
                </FormCell>
            </FormRow>
        </FormContent>
        <FormFooter>
            <Button OnClick="CloseAddRuleModal">Cancel</Button>
            <Button OnClick="HandleCreateRule" Color="E_COLOR_BASIC.Info">Add</Button>
        </FormFooter>
    </Form>
</Modal>

@code {
    #region Parameters
    [Parameter] public int ReportId { get; set; }
    #endregion

    #region Page State
    UserDTO? currentUser = null;
    ReportDTO? draftReport = null;   // null until loaded. The markup waits for it.
    #endregion

    #region Lifecycle
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            currentUser = await _userService.GetCurrentUser();
            draftReport = await _reportService.GetByIdWithAll(ReportId);
        }
        catch (HearthRecordNotFoundException)
        {
            // TODO show error toast
        }
    }
    #endregion

    #region Save Report
    async Task HandleSaveReport()
    {
        if (draftReport is null) return;
        await _reportService.Update(draftReport);
    }
    #endregion

    #region Add Rule
    bool showAddRuleModal = false;
    ReportTransactionRuleDTO draftTransactionRule = new();

    void OpenAddRuleModal()
    {
        draftTransactionRule = new() { Active = true };
        showAddRuleModal = true;
    }

    void CloseAddRuleModal() => showAddRuleModal = false;

    async Task HandleCreateRule()
    {
        if (draftReport is null) return;

        draftTransactionRule.ReportId = draftReport.Id;
        var created = await _reportTranRuleService.Create(draftTransactionRule);

        draftReport.Rules.Add(created);   // shows up in TransactionRules immediately
        CloseAddRuleModal();
    }
    #endregion

    #region Remove Rule
    /// <summary>
    /// Called by a RuleConditionsTableElement after the user confirms removal.
    /// Its conditions are deleted along with it by the database cascade.
    /// </summary>
    async Task HandleRemoveRule(RuleDTO rule)
    {
        if (draftReport is null) return;

        await _reportTranRuleService.Delete(rule.Id);
        draftReport.Rules.RemoveAll(r => r.Id == rule.Id);
    }
    #endregion

}