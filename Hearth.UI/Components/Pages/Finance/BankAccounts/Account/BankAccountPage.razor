@page "/finance/bank-accounts/{accountId}"
@using Hearth.Services.DTOs.Finance.Account
@using Hearth.Services.CTOs.Finance.Account
@using Hearth.Services.DTOs.Finance.Transaction
@using Hearth.UI.Components.Elements.Finance.Transactions.Lists
@inject IAccountService _accountService
@inject ITransactionService _transactionService

@* Loading *@

@if (initialRenderComplete == false)
{
    <LoadingCircleIcon AutoCenter="true" />
}

@* Page *@

<main class="main-bank-account" hidden="@(initialRenderComplete ? false : true)">
    <section class="section-01-account">
        <article class="s01-account-header-container">
            <div class="title-and-status">
                <div class="title" style="@($"background-color: {account.HexColor};")">
                    <Title HexColor="@account.HexColorText_C">
                        <Icon><BankIcon Size="28" /></Icon>
                        <ChildContent>@account.Name_C</ChildContent>
                    </Title>
                </div>
                @if (account.IsOpen)
                {
                    <div class="status" style="@($"background-color: var(--color-info")">
                        <Title Size="E_SIZE.sm" Color="E_COLOR_BASIC.OffWhite">@(account.IsOpen_C)</Title>
                    </div>
                }
                else
                {
                    <div class="status" style="@($"background-color: var(--color-primary")">
                        <Title Size="E_SIZE.sm" Color="E_COLOR_BASIC.OffWhite">@(account.IsOpen_C)</Title>
                    </div>
                }
            </div>
            <div class="description">
                @account.Official_Name | @account.Type
            </div>
        </article>
        <div class="lb">
            <LineBreak Size="E_SIZE.md" Width="14%" />
        </div>
        <article class="s01-account-body-container">
            @if (account.IsCredit_C)
            {

            }
            else
            {
                <div>
                    <div class="account-and-routing-numbers">
                        <div class="num-account">
                            <span>Account #</span>
                            <span class="num">@(string.IsNullOrWhiteSpace(account.AccountNumber) ? (" - ") : (account.AccountNumber))</span>
                        </div>
                        <div class="num-routing">
                            <span>Routing #</span>
                            <span class="num">@(string.IsNullOrWhiteSpace(account.AccountNumber) ? (" - ") : (account.AccountRoutingNumber))</span>
                        </div>
                    </div>
                </div>
                <div class="balance-container">
                    <div class="debit-grid">
                        <div class="grid-in">
                            <div class="header">
                                Avg. Incoming / mo
                            </div>
                            <div class="body">
                                <div class="num">
                                    @accountReport.Formated.Average_IncomingPerPeriod_Num_S
                                </div>
                                <div class="perc">
                                    <div class="icon-container">
                                        <ArrowIcon DirectionPoint="E_DIRECTION_EIGHT_POINT.UpRight" Size="26" />
                                    </div>
                                    <div class="value">
                                        @accountReport.Formated.Average_IncomingPerPeriod_Percent_S
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="grid-bal">
                            @account.Balances!.Current_S
                        </div>
                        <div class="grid-out">
                            <div class="header">
                                Avg. Outgoing / mo
                            </div>
                            <div class="body">
                                <div class="perc">
                                    <div class="icon-container">
                                        <ArrowIcon DirectionPoint="E_DIRECTION_EIGHT_POINT.DownRight" Size="26" />
                                    </div>
                                    <div class="value">
                                        @accountReport.Formated.Average_OutgoingPerPeriod_Percent_S
                                    </div>
                                </div>
                                <div class="num">
                                    @accountReport.Formated.Average_OutgoingPerPeriod_Num_S
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </article>
        <div class="01-account-footer-container">
        </div>
    </section>
    <section class="section-02-stats">
    </section>
    <div class="section-break">
        <LineBreak Size="E_SIZE.lg" Width="33%" />
    </div>
    <section class="section-03-transactions">
        <article class="s03-article-01">
            <div class="s03-a01-header">
                <Title>@account.Name_C Transactions</Title>
            </div>
        </article>
        <article class="s03-article-02">
            <div class="s03-a02-list-container">
                <TransactionCardListElement Transactions="@account.Transactions" />
            </div>
        </article>
    </section>
</main>

@* Toolbar *@

<Toolbar HasAddBtn="false"
         HasManageBtn="true"
         OnManage="OpenToolbarManageModal"
         HasSettingsBtn="false"
         Position="E_TOOLBAR_POSITION.BottomRight"
         Size="E_SIZE.lg"
         TooltipSubject="Account" />

@* Toolbar Modals *@
@* Manage Modal *@
<Modal Title="Manage Account Details"
    Size="E_SIZE.lg"
    Open="showToolbarManageModal"
    OnClose="CloseToolbarManageModal"
    HelpBtn="true"
    Variant="E_MODAL.AddEdit"
>
    <Form>
        <FormContent>
            <FormRow>
                <FormCell Ratio="4/6">
                    <Input InputType="E_INPUT_TYPE.Text" Label="Custom Name" Placeholder="Personal Debit" @bind-Value="accountDraft?.HearthName" />
                </FormCell>
                <FormCell Ratio="2/6" CenterVertically="true" AlignRight="true">
                    <Checkbox FlipLabel="true" Label="Status" @bind-Value="accountDraft.IsOpen" />
                </FormCell>
            </FormRow>
            <FormRow>
                <FormCell Ratio="1/2">
                    <Input InputType="E_INPUT_TYPE.Number" Label="Account Number" Placeholder="444400008888" @bind-Value="accountDraft?.AccountNumber" />
                </FormCell>
                <FormCell Ratio="1/2">
                    <Input InputType="E_INPUT_TYPE.Number" Label="Routing Number" Placeholder="123456789" @bind-Value="accountDraft?.AccountRoutingNumber" />
                </FormCell>
            </FormRow>
        </FormContent>
        <FormFooter>
            <Button Variant="E_VARIANT.Secondary" Color="E_COLOR_BASIC.OffWhite" Onclick="HandleCancelSave">Cancel</Button>
            <Button Variant="E_VARIANT.Primary" Color="E_COLOR_BASIC.Info" Onclick="HandleSave">Save</Button>
        </FormFooter>
    </Form>
</Modal>

@code {
    // - Loading -
    bool initialRenderComplete = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (initialRenderComplete == false && account != null)
            {
                initialRenderComplete = true;
                StateHasChanged(); // Trigger re-render to hide the spinner
            }
        }
    }

    // - Main Object -
    [Parameter] public string accountId { get; set; } = default!;
    int _accountId;
    AccountDTO? account = null;
    // - Report Object -
    AccountCTO? accountReport = null;
    AccountCTO_Options ctoOptions = new AccountCTO_Options
    {
        IncludeTransfers = true,
        Frequency = Foundation.Enums.E_CALENDAR_FREQUENCY.Monthly
    };
    private async void RefreshAccountReport()
    {
        if (account != null)
        {
            accountReport = await _accountService.GenerateAccountCTO(account, ctoOptions);
        }
    }
    // - Page -
    protected override async Task OnInitializedAsync()
    {
        _accountId = int.Parse(accountId);
        try
        {
            account = await _accountService.GetByIdWithTransactions(_accountId);
            RefreshAccountReport();
        }
        catch (HearthRecordNotFoundException)
        {
            // TODO
            throw;
        }
    }

    // - Toolbar -
    // Manage
    AccountDTO? accountDraft = null;
    bool showToolbarManageModal;

    void OpenToolbarManageModal()
    {
        showToolbarManageModal = true;
        accountDraft = account?.Clone();
        System.Diagnostics.Debug.WriteLine($"Same reference? {ReferenceEquals(account, accountDraft)}");
    }
    void CloseToolbarManageModal()
    {
        showToolbarManageModal = false;
        accountDraft = null;
    }

    void HandleCancelSave()
    {
        CloseToolbarManageModal();
    }

    void HandleSave()
    {
        InitiateUpdate();
        CloseToolbarManageModal();
    }

    async void InitiateUpdate()
    {
        if(account != null && accountDraft != null)
        {
            try
            {
                await _accountService.Update(accountDraft);
                account = accountDraft;
            }
            catch
            {
                throw; // TODO: Handle error
            }
        }
    }
}
