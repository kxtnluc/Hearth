@page "/"
@using Hearth.Services.DTOs
@using Hearth.Services.Interfaces
@inject IUserService _userService

<div class="home-main">
    @if (isLoggedIn)
    {
        // If user is logged in, show this page header instead.
        <div class="">Welcome Back, @loggedInUser?.Name</div>

        <Button OnClick="Logout">
            Logout
        </Button>
    }
    else
    {
        <div class="">Welcome to the Hearth</div>

        @if (newAppUser)
        {
            <div>
                Please create an account:
            </div>
            <div class="login-container">
                <div class="l-c">
                    <div class="l-c-name-container">
                        <Input Label="Name" @bind-Value="@newUser.Name" Placeholder="Marcus" />
                    </div>
                    <div class="l-c-password-container">
                        <Input Label="Pin" InputType="E_INPUT_TYPE.Password" @bind-Value="@newUser.Pin" Placeholder="1234abcd" />
                    </div>
                    <div class="l-c-error">
                        @if (loginFailure)
                        {
                            <span class="text-error">User not found, please try again.</span>
                        }
                    </div>
                    <div class="btn-container">
                        <Button OnClick="CreateUserAccount">
                            Create
                        </Button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="login-container">
                <div class="l-c">
                    <div class="l-c-name-container">
                        <Input Label="Name" @bind-Value="@nameInput" />
                    </div>
                    <div class="l-c-password-container">
                        <Input Label="Pin" InputType="E_INPUT_TYPE.Password" @bind-Value="@pinInput" />
                    </div>
                    <div class="l-c-error">
                        @if (loginFailure)
                        {
                            <span class="text-error">User not found, please try again.</span>
                        }
                    </div>
                    <div class="btn-container">
                        <Button OnClick="Login">
                            Login
                        </Button>
                    </div>
                </div>
            </div>
        }
    }
</div>


@code {
    #region Variables
    bool isLoggedIn = false;
    bool newAppUser = false;

    private UserDTO? loggedInUser = new UserDTO { };

    private string nameInput = string.Empty;
    private string pinInput = string.Empty;

    private UserDTO? newUser = new UserDTO { };

    private bool loginFailure = false;
    #endregion

    #region Functions
    // On Load
    protected override async Task OnInitializedAsync()
    {
        // Fetch Session Data
        isLoggedIn = await _userService.IsLoggedIn();
        loggedInUser = await _userService.GetCurrentUser();
        if(loggedInUser == null)
        {
            __TableDataDTO tableData = await _userService.GetTableData();
            newAppUser = tableData.IsEmpty;
        }
    }

    private async Task<bool> Login()
    {
        var success = false;
        success = await _userService.Login(nameInput, pinInput);
        if (success)
        {
            // TODO-2: reload the page to reflect the new login state
        }
        else
        {
            loginFailure = true;
        }
        return success;
    }

    private async Task<bool> Logout()
    {
        var success = false;

        if (loggedInUser != null)
        {
            success = await _userService.Logout(loggedInUser);
            if (success)
            {
                // TODO-2: reload the page to reflect the new logout state
            }
        }

        return success;
    }

    private async Task<UserDTO?> CreateUserAccount()
    {
        if (newUser == null) return null;

        UserDTO? createdUser = await _userService.Create(newUser);

        if (createdUser != null)
        {
            // TODO-2: reload the page to reflect the new login state
        }
        else
        {
            loginFailure = true;
        }
        return createdUser;
    }
    #endregion

}