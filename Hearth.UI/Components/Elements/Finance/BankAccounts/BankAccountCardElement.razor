@using Hearth.Services.DTOs.Finance.Account

<div class="bank-account-card-element-wraper">
    <ClickWraper OnClick="@(() => HandleAccountClick(Account.Id))">
        <Card Variant="E_CARD.Raised" HoverEffects="true">
            <CardHeader>
                <CardTitle>
                    <Icon>
                        <BankIcon Size="22" />
                    </Icon>
                    <Title>@Account.Name</Title>
                </CardTitle>
                <CardDescription>
                    @Account.Official_Name
                </CardDescription>
                <CardAction>
                    <span class="bank-account-type">@Account.Type?.ToUpper()</span>
                </CardAction>
            </CardHeader>
            <CardContent IsDataPoint="true">@Account.Balances.Current?.ToString("C") @Account.Balances.Iso_Currency_Code</CardContent>
            <CardFooter IsDataPoint="true" DataStatus="E_STATUS.Neutral" LateralDirection="E_DIRECTION_LATERAL.Right">
                @(Account.Is_Credit_C ? ("Credit") : ("Debit"))
            </CardFooter>
        </Card>
    </ClickWraper>
</div>

@code {
    // - DTO -
    [Parameter] public AccountDTO Account { get; set; } = default!;

    // - Logic -
    private void HandleAccountClick(int id)
    {
        // _navigation.NavigateTo($"/finances/accounts/{id}");
    }
}